%
% specification used to coordinate philosophers
%

% protocols:
%   to acquire the chopsticks:  in(chops(+C1,+C2))
%   to release the chopsticks:  out(chops(+C1,+C2))
%


reaction(in(chops(C1,C2)),
		(exo, request), (
        out(required(C1,C2)))).

reaction(in(chops(C1,C2)),
		(exo, response), (
        in(required(C1,C2)))).

reaction(out(required(C1,C2)),
		endo, (
        in(chop(C1)),
        in(chop(C2)),
        out(chops(C1,C2)))).

reaction(out(chops(C1,C2)),
		exo, (
        in(chops(C1,C2)),
        out(chop(C1)),
        out(chop(C2)))).

reaction(out(chop(C1)),
		endo, (
        rd(required(C1,C)),
        in(chop(C1)),
        in(chop(C)),
        out(chops(C1,C)))).

reaction(out(chop(C2)),
		endo, (
        rd(required(C,C2)),
        in(chop(C)),
        in(chop(C2)),
        out(chops(C,C2)))).


